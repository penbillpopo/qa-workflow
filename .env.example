# 複製這個檔案並改名為 .env，再把等號後面填上自己的值。
# .env 不會進 git，裡面的帳密不要傳到聊天軟體或信件。

# TestRail：用你自己的 TestRail 帳號
# API key 取得：登入 https://gorun.testrail.io/index.php?/mysettings → API Keys → Add Key → Save Settings
TESTRAIL_INSTANCE_URL=https://gorun.testrail.io
TESTRAIL_USERNAME=
TESTRAIL_API_KEY=
TESTRAIL_ALLOW_WRITE_OPERATIONS=true

# 各專案測試帳號（全部都是 UAT 環境的帳號，向主管索取）
# GoMoneyAdmin
GOMONEY_ADMIN_USERNAME=
GOMONEY_ADMIN_PASSWORD=
# PlatformAdmin
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=
# PlatformWeb（目前暫停測試，可以先留空）
PLATFORM_WEB_USERNAME=
PLATFORM_WEB_PASSWORD=

# UAT 固定的 OTP 驗證碼（向主管索取）
OTP_CODE=
